# OpenAI or Azure OpenAI Responses API, used by the server only.
# The UI remains usable in demonstration mode when credentials are not set.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=

# For Azure OpenAI, set AI_PROVIDER=azure and provide both deployments.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_GPT6=
AZURE_OPENAI_DEPLOYMENT_GPT56_SOL=
AZURE_OPENAI_DEPLOYMENT_GPT56_TERRA=
AZURE_OPENAI_DEPLOYMENT_GPT56_LUNA=

PORT=3001
HOST=127.0.0.1
MAX_UPLOAD_MB=30
VITE_API_BASE_URL=
# Add https://ryusui-hiro.github.io when connecting the Pages app to this server.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,tauri://localhost,http://tauri.localhost,https://tauri.localhost
# Optional: override the Codex App Server executable. On macOS the ChatGPT app binary is preferred when available; otherwise `codex` from PATH is used.
CODEX_APP_SERVER_BIN=
CODEX_APP_SERVER_DISABLED=false
ALLOW_HTTP_API_ENDPOINTS=false
