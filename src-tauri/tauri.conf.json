{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Annotation Studio",
  "version": "0.1.0",
  "identifier": "com.annotationstudio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "npm run prepare:desktop-runtime && npm run test:desktop-runtime",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Annotation Studio",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "resources": {
      "resources/desktop-runtime/": "desktop-runtime/"
    }
  }
}
