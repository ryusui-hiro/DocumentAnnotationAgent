{
  "name": "annotation-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "lint": "tsc --noEmit",
    "test": "tsx --test server/*.test.ts src/*.test.ts scripts/*.test.mjs",
    "test:office-native-export-libreoffice": "node --import tsx scripts/office-native-export-libreoffice-acceptance.mjs",
    "test:browser-e2e": "node scripts/test-browser-e2e.mjs",
    "test:agent-sse-browser-e2e": "node scripts/agent-sse-browser-e2e.mjs",
    "test:live-codex-smoke": "node --import tsx scripts/live-codex-smoke.mjs",
    "test:live-provider-smoke": "node --import tsx scripts/live-provider-smoke.mjs",
    "test:installed-desktop-e2e": "node scripts/test-installed-desktop-e2e.mjs",
    "test:desktop-runtime": "node scripts/test-desktop-runtime.mjs",
    "start": "tsx server/index.ts --serve-frontend",
    "create:demo": "tsx scripts/create-demo-pdf.ts",
    "create:product-hunt-contract-demo": "tsx scripts/create-product-hunt-contract-demo.ts",
    "create:product-hunt-demo": "node scripts/create-product-hunt-demo.mjs",
    "create:product-hunt-churn-demo": "node scripts/create-product-hunt-churn-demo.mjs",
    "create:product-hunt-gif": "node scripts/create-product-hunt-demo-gif.mjs",
    "create:product-hunt-pdf-gif": "node scripts/create-product-hunt-pdf-agent-gif.mjs",
    "create:termination-demo": "tsx scripts/create-termination-contract-demo.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "prepare:desktop-runtime": "node scripts/prepare-tauri-runtime.mjs",
    "build:pages": "tsc --noEmit && vite build --mode pages",
    "test:static-pages": "node scripts/test-static-pages.mjs",
    "create:launch-assets": "node scripts/create-launch-assets.mjs",
    "create:readme-gif": "node scripts/create-readme-gif.mjs"
  },
  "dependencies": {
    "@openai/agents": "^0.18.0",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@xmldom/xmldom": "^0.9.12",
    "document-svg": "^0.1.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "jszip": "^3.10.2",
    "katex": "^0.18.9",
    "lucide-react": "^1.49.0",
    "multer": "^2.4.0",
    "openai": "^7.25.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.22",
    "@tauri-apps/cli": "^2.12.0",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
